# Nur Namen, keine Werte. Lokal stehen sie nach `supabase start` in der Ausgabe von `supabase status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# KI: aus, solange AI_ENABLED nicht `on` ist. LLM_PROVIDER: fake | anthropic. Den Schlüssel legt Sinan in Infisical an.
AI_ENABLED=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Demo-Modus: `on` = App ohne Login und ohne Supabase mit Beispieldaten im Speicher (nur Vorschau/lokal, nie Produktion).
NEXT_PUBLIC_DEMO_MODE=
